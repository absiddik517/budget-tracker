{
  "entities": {
    "User": {
      "title": "Office User",
      "description": "Authenticated office staff member with role-based permissions.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["superAdmin", "ddo", "employee"] },
        "status": { "type": "string", "enum": ["invited", "active", "disabled"] }
      },
      "required": ["name", "email", "role", "status"]
    },
    "EconomicCode": {
      "title": "Economic Code",
      "description": "Master government expenditure head code.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "headName": { "type": "string" },
        "headNameBn": { "type": "string" },
        "active": { "type": "boolean" },
        "special": { "type": "boolean" }
      },
      "required": ["code", "headName", "active"]
    },
    "Budget": {
      "title": "Budget Allocation",
      "description": "Allocation or revision under an economic code and fiscal year.",
      "type": "object",
      "properties": {
        "fiscalYear": { "type": "string" },
        "memoNo": { "type": "string" },
        "memoDate": { "type": "string" },
        "economicCode": { "type": "string" },
        "allocated": { "type": "integer" },
        "spent": { "type": "integer" },
        "approvedSpent": { "type": "integer" },
        "pendingAmount": { "type": "integer" },
        "remaining": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "executed"] }
      },
      "required": ["fiscalYear", "memoNo", "economicCode", "allocated", "spent", "remaining", "status"]
    },
    "ExpenseItem": {
      "title": "Expense Item",
      "description": "Individual expenditure item before bill preparation (no VAT/IT deduction).",
      "type": "object",
      "properties": {
        "fiscalYear": { "type": "string" },
        "economicCode": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "integer" },
        "responsibleEmployee": { "type": "object" },
        "status": { "type": "string", "enum": ["listed", "billed"] },
        "billId": { "type": ["string", "null"] }
      },
      "required": ["fiscalYear", "economicCode", "date", "description", "amount", "responsibleEmployee", "status"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Grouped bill for an economic code with VAT & Income Tax snapshot and DDO workflow.",
      "type": "object",
      "properties": {
        "billNo": { "type": "string" },
        "fiscalYear": { "type": "string" },
        "economicCode": { "type": "string" },
        "date": { "type": "string" },
        "billDate": { "type": "string" },
        "tokenNo": { "type": "string" },
        "purposeText": { "type": "string" },
        "payeeText": { "type": "string" },
        "netPayableCode": { "type": "string" },
        "supplier": { "type": ["object", "null"] },
        "deductions": { "type": "array" },
        "itemIds": { "type": "array", "items": { "type": "string" } },
        "items": { "type": "array" },
        "grossAmount": { "type": "integer" },
        "vatRate": { "type": "number" },
        "itRate": { "type": "number" },
        "vatAmount": { "type": "integer" },
        "itAmount": { "type": "integer" },
        "totalDeduction": { "type": "integer" },
        "netPayable": { "type": "integer" },
        "status": { "type": "string", "enum": ["draft", "submitted", "approved", "rejected", "cancelled"] }
      },
      "required": ["fiscalYear", "economicCode", "itemIds", "grossAmount", "vatAmount", "itAmount", "totalDeduction", "netPayable", "status"]
    },
    "FyCounter": {
      "title": "Fiscal Year Counter",
      "description": "Sequential bill number generator per fiscal year.",
      "type": "object",
      "properties": {
        "fiscalYear": { "type": "string" },
        "nextNumber": { "type": "integer" }
      },
      "required": ["fiscalYear", "nextNumber"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{uid}": { "schema": { "$ref": "#/entities/User" }, "description": "Office users" },
    "/invites/{emailLower}": { "description": "Pending user invitations" },
    "/settings/{docId}": { "description": "Office settings" },
    "/economicCodes/{code}": { "schema": { "$ref": "#/entities/EconomicCode" }, "description": "Master economic codes" },
    "/vatTaxRates/{rateId}": { "description": "VAT and Income Tax rates per FY" },
    "/spendingLimits/{limitId}": { "description": "Ministry spending percentage caps" },
    "/fyCodeTotals/{totalId}": { "description": "Aggregated FY + Economic Code allocation, approvedSpent, and pendingAmount" },
    "/budgets/{budgetId}": { "schema": { "$ref": "#/entities/Budget" }, "description": "Budget allocations and revisions" },
    "/expenseItems/{itemId}": { "schema": { "$ref": "#/entities/ExpenseItem" }, "description": "Listed and billed expense items" },
    "/bills/{billId}": { "schema": { "$ref": "#/entities/Bill" }, "description": "Office bills awaiting or completing DDO approval" },
    "/counters/{counterId}": { "schema": { "$ref": "#/entities/FyCounter" }, "description": "Sequential FY bill counters" },
    "/spendings/{spendingId}": { "description": "Legacy spendings retained for migration" },
    "/auditLogs/{logId}": { "description": "Immutable audit trail" }
  }
}
