{
  "entities": {
    "Office": {
      "title": "Government Office",
      "description": "Organizational boundary for budgets, expenses, bills, limits, and office-level settings.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameBn": { "type": "string" },
        "code": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "activeFiscalYear": { "type": "string" },
        "fiscalYears": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "nameBn", "code", "status", "activeFiscalYear"]
    },
    "User": {
      "title": "User",
      "description": "Authenticated user with optional Super Admin global role and per-office access map.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["invited", "active", "disabled"] },
        "globalRole": { "type": ["string", "null"], "enum": ["superAdmin", null] },
        "homeOfficeId": { "type": ["string", "null"] },
        "access": { "type": "object" },
        "officeIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "email", "status", "access"]
    },
    "WorkHistory": {
      "title": "Work History Posting",
      "description": "Immutable record of a regular or additional-charge posting at an office.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "officeId": { "type": "string" },
        "role": { "type": "string", "enum": ["ddo", "employee"] },
        "kind": { "type": "string", "enum": ["regular", "additionalCharge"] },
        "designation": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["active", "ended"] },
        "orderNo": { "type": "string" },
        "orderDate": { "type": "string" },
        "endReason": { "type": ["string", "null"] },
        "assignedBy": { "type": "object" },
        "remarks": { "type": "string" }
      },
      "required": ["userId", "officeId", "role", "kind", "startDate", "status"]
    },
    "EconomicCode": {
      "title": "Economic Code",
      "description": "Global master government expenditure head code.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "headName": { "type": "string" },
        "headNameBn": { "type": "string" },
        "active": { "type": "boolean" },
        "special": { "type": "boolean" }
      },
      "required": ["code", "headName", "active"]
    },
    "Budget": {
      "title": "Budget Allocation",
      "description": "Office-scoped allocation or revision under an economic code and fiscal year.",
      "type": "object",
      "properties": {
        "officeId": { "type": "string" },
        "fiscalYear": { "type": "string" },
        "memoNo": { "type": "string" },
        "memoDate": { "type": "string" },
        "economicCode": { "type": "string" },
        "allocated": { "type": "integer" },
        "spent": { "type": "integer" },
        "approvedSpent": { "type": "integer" },
        "pendingAmount": { "type": "integer" },
        "remaining": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "executed"] }
      },
      "required": ["officeId", "fiscalYear", "memoNo", "economicCode", "allocated", "spent", "remaining", "status"]
    },
    "ExpenseItem": {
      "title": "Expense Item",
      "description": "Office-scoped individual expenditure item before bill preparation.",
      "type": "object",
      "properties": {
        "officeId": { "type": "string" },
        "fiscalYear": { "type": "string" },
        "economicCode": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "integer" },
        "amountBasis": { "type": "string", "enum": ["voucher"] },
        "products": { "type": "array" },
        "baseTotal": { "type": "integer" },
        "vatTotal": { "type": "integer" },
        "itTotal": { "type": "integer" },
        "deductionTotal": { "type": "integer" },
        "responsibleEmployee": { "type": "object" },
        "status": { "type": "string", "enum": ["listed", "billed"] },
        "billId": { "type": ["string", "null"] }
      },
      "required": ["officeId", "fiscalYear", "economicCode", "date", "description", "amount", "responsibleEmployee", "status"]
    },
    "ProductRate": {
      "title": "Product Rate Memory",
      "description": "Per-office remembered VAT & IT rates keyed by normalized product name.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "vatRate": { "type": "number" },
        "itRate": { "type": "number" },
        "lastEconomicCode": { "type": "string" }
      },
      "required": ["name", "vatRate", "itRate", "lastEconomicCode"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Office-scoped grouped bill with VAT & IT deductions and DDO approval workflow.",
      "type": "object",
      "properties": {
        "officeId": { "type": "string" },
        "billNo": { "type": "string" },
        "fiscalYear": { "type": "string" },
        "economicCode": { "type": "string" },
        "date": { "type": "string" },
        "itemIds": { "type": "array", "items": { "type": "string" } },
        "items": { "type": "array" },
        "grossAmount": { "type": "integer" },
        "vatRate": { "type": "number" },
        "itRate": { "type": "number" },
        "vatAmount": { "type": "integer" },
        "itAmount": { "type": "integer" },
        "totalDeduction": { "type": "integer" },
        "netPayable": { "type": "integer" },
        "status": { "type": "string", "enum": ["draft", "submitted", "approved", "rejected", "cancelled"] }
      },
      "required": ["officeId", "fiscalYear", "economicCode", "itemIds", "grossAmount", "vatAmount", "itAmount", "totalDeduction", "netPayable", "status"]
    },
    "FyCounter": {
      "title": "Fiscal Year Counter",
      "description": "Sequential bill number generator per office and fiscal year.",
      "type": "object",
      "properties": {
        "officeId": { "type": "string" },
        "fiscalYear": { "type": "string" },
        "nextNumber": { "type": "integer" }
      },
      "required": ["officeId", "fiscalYear", "nextNumber"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/offices/{officeId}": { "schema": { "$ref": "#/entities/Office" }, "description": "Offices" },
    "/offices/{officeId}/productRates/{rateKey}": { "schema": { "$ref": "#/entities/ProductRate" }, "description": "Office-scoped product VAT & IT rate memory" },
    "/users/{uid}": { "schema": { "$ref": "#/entities/User" }, "description": "Users & per-office access maps" },
    "/workHistory/{whId}": { "schema": { "$ref": "#/entities/WorkHistory" }, "description": "Posting history records" },
    "/invites/{emailLower}": { "description": "Pending user invitations with office/role/kind" },
    "/settings/{docId}": { "description": "Legacy single-office settings and bootstrap sentinel" },
    "/economicCodes/{code}": { "schema": { "$ref": "#/entities/EconomicCode" }, "description": "Global master economic codes" },
    "/vatTaxRates/{rateId}": { "description": "Global VAT and Income Tax rates per FY" },
    "/spendingLimits/{limitId}": { "description": "Office-scoped ministry spending percentage caps" },
    "/fyCodeTotals/{totalId}": { "description": "Office + FY + Economic Code totals ({officeId}_{fy}_{code})" },
    "/budgets/{budgetId}": { "schema": { "$ref": "#/entities/Budget" }, "description": "Office-scoped budget allocations" },
    "/expenseItems/{itemId}": { "schema": { "$ref": "#/entities/ExpenseItem" }, "description": "Office-scoped expense items" },
    "/bills/{billId}": { "schema": { "$ref": "#/entities/Bill" }, "description": "Office-scoped bills" },
    "/counters/{counterId}": { "schema": { "$ref": "#/entities/FyCounter" }, "description": "Office + FY bill counters ({officeId}_{fy}_bill)" },
    "/spendings/{spendingId}": { "description": "Legacy spendings retained for migration" },
    "/auditLogs/{logId}": { "description": "Immutable office-scoped and global audit trail" }
  }
}
