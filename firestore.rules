rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userExists() {
      return isSignedIn() && exists(userPath(request.auth.uid));
    }

    function userData() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActiveUser() {
      return userExists() && userData().status == 'active';
    }

    function role() {
      return userData().role;
    }

    function isSuperAdmin() {
      return isActiveUser() && role() == 'superAdmin';
    }

    function isDdo() {
      return isActiveUser() && role() == 'ddo';
    }

    function isDdoOrSuperAdmin() {
      return isActiveUser() && (role() == 'ddo' || role() == 'superAdmin');
    }

    function officeInitialized() {
      return exists(/databases/$(database)/documents/settings/office);
    }

    function hasEmail() {
      return isSignedIn() && request.auth.token.email != null;
    }

    function ownEmailLower() {
      return request.auth.token.email.lower();
    }

    // Users collection (all active office users can list staff directory for responsibleEmployee selection)
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isActiveUser());
      allow list: if isActiveUser() || (isSignedIn() && !officeInitialized());

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.status == 'active'
        && (
          (!officeInitialized() && request.resource.data.role == 'superAdmin')
          || (
            hasEmail()
            && exists(/databases/$(database)/documents/invites/$(ownEmailLower()))
            && request.resource.data.role == get(/databases/$(database)/documents/invites/$(ownEmailLower())).data.role
          )
        );

      allow update: if isSuperAdmin()
        || (
          isActiveUser()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
        );

      allow delete: if isSuperAdmin();
    }

    // Invites collection (keyed by email lowercase)
    match /invites/{emailLower} {
      allow get: if isSuperAdmin()
        || (hasEmail() && ownEmailLower() == emailLower);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin()
        || (hasEmail() && ownEmailLower() == emailLower);
    }

    // Office settings
    match /settings/{docId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isSuperAdmin();
    }

    // Master Economic Codes
    match /economicCodes/{code} {
      allow read: if isActiveUser();
      allow create, update: if isDdoOrSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // VAT & Tax Model
    match /vatTaxRates/{rateId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isDdoOrSuperAdmin();
    }

    // Spending Limits (Maximum Spending Rate)
    match /spendingLimits/{limitId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isDdoOrSuperAdmin();
    }

    // Aggregated FY + Economic Code totals
    match /fyCodeTotals/{totalId} {
      allow read: if isActiveUser();
      allow create: if isDdoOrSuperAdmin()
        || (
          isActiveUser()
          && request.resource.data.keys().hasOnly([
            'fiscalYear',
            'economicCode',
            'allocated',
            'spent',
            'approvedSpent',
            'pendingAmount',
            'updatedAt',
            'updatedBy'
          ])
        );
      allow update: if isDdoOrSuperAdmin()
        || (
          isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pendingAmount', 'approvedSpent', 'updatedAt', 'updatedBy'])
        );
      allow delete: if isSuperAdmin();
    }

    // Budgets (allocations and revisions)
    match /budgets/{budgetId} {
      allow read: if isActiveUser();
      allow create: if isDdoOrSuperAdmin();
      allow update: if isSuperAdmin()
        || (
          isDdo()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['spent', 'approvedSpent', 'pendingAmount', 'remaining', 'status', 'updatedAt', 'updatedBy'])
        )
        || (
          isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pendingAmount', 'remaining', 'updatedAt', 'updatedBy'])
        );
      allow delete: if isSuperAdmin();
    }

    // Sequential Bill Number Counters (per FY)
    match /counters/{counterId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isSuperAdmin();
    }

    // Expense Items (খরচ তালিকা)
    match /expenseItems/{itemId} {
      allow read: if isActiveUser();

      allow create: if (
          isSuperAdmin()
          && request.resource.data.deleted == false
        )
        || (
          isActiveUser()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'listed'
          && request.resource.data.deleted == false
        );

      allow update: if (
          // Link a 'listed' item to a newly drafted bill
          isActiveUser()
          && resource.data.status == 'listed'
          && request.resource.data.status == 'billed'
          && request.resource.data.billId is string
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'billId', 'updatedAt', 'updatedBy'])
        )
        || (
          // Return 'billed' item back to 'listed' on DDO reject/cancel or draft delete
          isActiveUser()
          && resource.data.status == 'billed'
          && request.resource.data.status == 'listed'
          && request.resource.data.billId == null
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'billId', 'updatedAt', 'updatedBy'])
        )
        || (
          // Edit or soft-delete ONLY while status == 'listed'
          isActiveUser()
          && resource.data.status == 'listed'
          && request.resource.data.status == 'listed'
          && (isDdoOrSuperAdmin() || resource.data.createdBy == request.auth.uid)
          && (
            request.resource.data.deleted == false
            || (
              request.resource.data.deleted == true
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['deleted', 'updatedAt', 'updatedBy'])
            )
          )
        );

      allow delete: if isSuperAdmin();
    }

    // Bills (বিল) - Strictly DDO-only for Approve / Reject / Cancel
    match /bills/{billId} {
      allow read: if isActiveUser();

      allow create: if (
          isSuperAdmin()
          && request.resource.data.deleted == false
        )
        || (
          isActiveUser()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'draft'
          && request.resource.data.deleted == false
        );

      allow update: if (
          // Creator, DDO, or Super Admin can edit/submit/soft-delete ONLY while draft
          isActiveUser()
          && resource.data.status == 'draft'
          && (resource.data.createdBy == request.auth.uid || isDdoOrSuperAdmin())
          && (
            (request.resource.data.status in ['draft', 'submitted'] && request.resource.data.deleted == false)
            || (
              request.resource.data.deleted == true
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['deleted', 'updatedAt', 'updatedBy'])
            )
          )
        )
        || (
          // Strictly DDO ONLY: Approve submitted bill
          isDdo()
          && resource.data.status == 'submitted'
          && request.resource.data.status == 'approved'
          && request.resource.data.deleted == false
        )
        || (
          // Strictly DDO ONLY: Reject submitted bill with reason
          isDdo()
          && resource.data.status == 'submitted'
          && request.resource.data.status == 'rejected'
          && request.resource.data.rejectReason is string
          && request.resource.data.rejectReason.size() > 0
          && request.resource.data.deleted == false
        )
        || (
          // Strictly DDO ONLY: Cancel approved bill with reason
          isDdo()
          && resource.data.status == 'approved'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelReason is string
          && request.resource.data.cancelReason.size() > 0
          && request.resource.data.deleted == false
        );

      allow delete: if isSuperAdmin();
    }

    // Legacy Spendings (kept read-only / legacy-compatible for migration)
    match /spendings/{spendingId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isSuperAdmin();
    }

    // Immutable Audit Logs
    match /auditLogs/{logId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
